# Copie para deploy/.env e gere segredos exclusivos; não versione o arquivo preenchido.
SERVICE_TOKEN=
TENANTS_JSON={}
CONTACT_CENTER_PORT=8090
CHATWOOT_PORT=3000
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.19.0
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
FRONTEND_URL=http://localhost:3000
# Use uma conta LiveKit Cloud para o agente com LiveKit Inference.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_STT_MODEL=deepgram/nova-3
VOICE_LLM_MODEL=google/gemma-4-31b-it
VOICE_TTS_MODEL=cartesia/sonic-3
VOICE_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# IA de texto: endpoint compatível com chat completions (ex.: Ollama).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Entrada única de leads 24h: o serviço repassa cada mensagem recebida ao CRM.
# Use o mesmo segredo (mín. 32 caracteres) aqui e na variável CRM_INTAKE_SECRET do Site.
# Em TENANTS_JSON, informe "crm_owner" com o ID do usuário dono dos registros no CRM.
CRM_INTAKE_URL=
CRM_INTAKE_SECRET=
